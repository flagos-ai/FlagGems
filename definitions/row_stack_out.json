{
  "api_version": "v6.0",
  "name": "row_stack_out",
  "requires_triton_kernel": true,
  "description": "ATen row_stack.out stacks tensors vertically into the keyword-only out tensor, mutates out, and returns that same tensor.",
  "parameters": [
    {
      "name": "tensors",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "list"
    },
    {
      "name": "out",
      "kind": "keyword_only",
      "required": true,
      "type_hint": "torch.Tensor"
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "out"
    ],
    "returns_alias_of": {
      "out": "out"
    }
  }
}
