ARG BASE_IMAGE=fedora
ARG BASE_IMAGE_VERSION=43

FROM ${BASE_IMAGE}:${BASE_IMAGE_VERSION}

# pyproject-rpm-macros exists on Fedora/EL9+ but not openEuler 24.03;
# install it opportunistically so the image builds either way. The spec
# detects it at parse time and falls back to a plain pip build without it.
RUN dnf install -y \
    rpm-build rpmdevtools \
    python3-devel python3-setuptools python3-wheel python3-pip \
    python3-setuptools_scm \
    && (dnf install -y pyproject-rpm-macros \
        || echo "pyproject-rpm-macros unavailable; spec uses pip fallback") \
    && dnf clean all

# pyproject.toml declares setuptools-scm>=8.0; openEuler 24.03 ships 7.1.0.
# Upgrade only when the distro version is too old (a no-op on Fedora).
# --prefix /usr overwrites the distro module in place: python drops
# /usr/local from sys.path inside rpmbuild (RPM_BUILD_ROOT detection), so a
# default pip install would be invisible to %build.
RUN python3 -c "import importlib.metadata as m, sys; \
        sys.exit(0 if int(m.version('setuptools-scm').split('.')[0]) >= 8 else 1)" \
    || { python3 -m pip install --no-cache-dir --prefix /usr "setuptools-scm>=8.0" \
         && rm -rf /usr/lib/python3*/site-packages/setuptools_scm-7.*.dist-info; }

# openEuler images define %dist as empty (official .oe* tags are injected by
# EulerMaker); reconstruct it so local/CI builds get distro-tagged Release
# fields like official packages.
RUN if [ -z "$(rpm --eval '%{?dist}')" ]; then \
        . /etc/os-release && \
        case "${ID}" in \
            openEuler) echo "%dist .oe$(echo "${VERSION_ID}" | tr -d '.')" >> /root/.rpmmacros ;; \
        esac; \
    fi

RUN rpmdev-setuptree

# Narrow COPY: only the paths the rpm source tarball actually needs.
# Mirrors the Dockerfile.deb wheel-builder COPY list, so packaging-only edits
# (docs, .github, notebooks) don't bust the rpm build cache.
COPY pyproject.toml setup.py LICENSE README.md /workspace/FlagGems/
COPY src /workspace/FlagGems/src
COPY tests /workspace/FlagGems/tests
COPY benchmark /workspace/FlagGems/benchmark
COPY packaging/rpm/specs /workspace/FlagGems/packaging/rpm/specs

RUN SPEC_VERSION=$(grep '^Version:' /workspace/FlagGems/packaging/rpm/specs/flag-gems.spec | awk '{print $2}') && \
    tar czf /root/rpmbuild/SOURCES/flag-gems-${SPEC_VERSION}.tar.gz \
        -C /workspace/FlagGems \
        --exclude='./.git' \
        --transform "s|^\./|flag-gems-${SPEC_VERSION}/|" \
        .

RUN rpmbuild -ba /workspace/FlagGems/packaging/rpm/specs/flag-gems.spec 2>&1 || \
    { echo "=== build failed ==="; \
      find /root/rpmbuild -name "*.log" -exec echo "=== {} ===" \; -exec cat {} \; 2>/dev/null || true; \
      exit 1; }

RUN mkdir -p /output && \
    find /root/rpmbuild/RPMS -name "*.rpm" -exec cp {} /output/ \; && \
    find /root/rpmbuild/SRPMS -name "*.rpm" -exec cp {} /output/ \; && \
    ls -lh /output/
