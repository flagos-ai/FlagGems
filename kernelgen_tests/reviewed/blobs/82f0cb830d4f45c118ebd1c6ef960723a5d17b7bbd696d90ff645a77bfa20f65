"""Prepared reference solution for ``special_chebyshev_polynomial_t`` (ascend).

This file is the reference-as-solution candidate for the frozen FlagGems pytest
probe. It is injected through the existing official override path:

    --override special_chebyshev_polynomial_t:<this file>:run

Numerics come from the native Torch oracle
(``torch.special.chebyshev_polynomial_t``), never from the FlagGems candidate
module, so the wrapper cannot recurse into, or borrow the answer from, the
implementation under preparation. The only non-oracle clause is the compute
dtype contract taken from the frozen Definition
(``definitions/special_chebyshev_polynomial_t.json``): float32/float64 are
supported and any other input dtype is rejected, which is what the existing
suite asserts for an int32 input.

Declared entrypoint: ``run(x, n)`` where ``n`` may be a Python int (the
``n_scalar`` overload) or an integer Tensor (the ``.default`` overload), since
the frozen suite and benchmark exercise both call shapes.
"""

import torch

# Frozen Definition: "The kernel is float32/float64 only".
_SUPPORTED_DTYPES = (torch.float32, torch.float64)


def run(x, n):
    """Return ``T_n(x)`` with the native aten/Torch semantics for ``x``, ``n``."""
    if x.dtype not in _SUPPORTED_DTYPES:
        raise ValueError(
            "special_chebyshev_polynomial_t only supports float32/float64, "
            f"got {x.dtype}"
        )
    return torch.special.chebyshev_polynomial_t(x, n)
