"""Prepared reference solution for ``_thnn_fused_lstm_cell_backward_impl``.

Preparation-only artifact for the project ``pytest-review`` probe in the
``--phase reference-as-solution`` run: the same file is passed as both
``--candidate`` and ``--reference-source`` and is injected through the
existing FlagGems ``--override`` protocol, so it is the callable the native
suites observe under ``flag_gems._thnn_fused_lstm_cell_backward_impl``.

The body is an independent re-implementation of the frozen LSTM-cell
backward from the forward workspace.  It never imports ``flag_gems`` and
never delegates to the replaced export (``torch.ops.aten.
_thnn_fused_lstm_cell_backward_impl``), so it can neither re-enter the
overridden operator nor use the current candidate as its own oracle; the
native ATen operator stays the golden reference inside the test bodies.

Signature / outputs follow the frozen Definition
(``definitions/_thnn_fused_lstm_cell_backward_impl.json``):
``(grad_hy, grad_cy, cx, cy, workspace, has_bias)`` ->
``(grad_input_gates, grad_cx, grad_biases)``.
"""

import torch


def run(grad_hy, grad_cy, cx, cy, workspace, has_bias):
    """Return the fused LSTM-cell gradients for the forward ``workspace``."""
    hidden_size = cx.shape[1]

    # ``grad_hy`` / ``grad_cy`` are ``Tensor?``: an absent upstream gradient
    # contributes zeros (not exercised by the selected cases today).
    if grad_hy is None:
        grad_hy = torch.zeros_like(cy)
    if grad_cy is None:
        grad_cy = torch.zeros_like(cx)

    # The workspace may be a sliced view of the forward output.
    grad_hy = grad_hy.contiguous()
    grad_cy = grad_cy.contiguous()
    cx = cx.contiguous()
    cy = cy.contiguous()
    workspace = workspace.contiguous()

    # workspace layout along dim=1: [i_gate, f_gate, g_gate, o_gate]
    input_gate = workspace[:, :hidden_size]
    forget_gate = workspace[:, hidden_size : 2 * hidden_size]
    cell_gate = workspace[:, 2 * hidden_size : 3 * hidden_size]
    output_gate = workspace[:, 3 * hidden_size : 4 * hidden_size]

    tanh_cy = torch.tanh(cy)
    # dL/d(cy_in) = dL/dhy * o * (1 - tanh(cy)**2) + dL/dcy_out
    grad_cell = grad_cy + grad_hy * output_gate * (1.0 - tanh_cy * tanh_cy)

    grad_input_gates = torch.cat(
        (
            grad_cell * cell_gate * input_gate * (1.0 - input_gate),
            grad_cell * cx * forget_gate * (1.0 - forget_gate),
            grad_cell * input_gate * (1.0 - cell_gate * cell_gate),
            grad_hy * tanh_cy * output_gate * (1.0 - output_gate),
        ),
        dim=1,
    )
    grad_cx = grad_cell * forget_gate

    if has_bias:
        grad_biases = grad_input_gates.sum(dim=0)
    else:
        grad_biases = torch.zeros(0, dtype=cx.dtype, device=cx.device)

    return grad_input_gates, grad_cx, grad_biases
