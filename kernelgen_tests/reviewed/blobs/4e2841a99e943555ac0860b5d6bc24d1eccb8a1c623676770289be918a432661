"""Prepared reference solution for ``aten::quantized_lstm.input``.

This file is the reference-as-solution source injected through the Gems-native
``--override quantized_lstm:<this file>:run`` option, so ``flag_gems.quantized_lstm``
resolves to :func:`run` for one review process.  It reimplements the operator
with ordinary torch ops on the input device and deliberately does **not** import
``flag_gems`` nor call the current candidate/kernel module, so the observed
candidate never becomes its own oracle and no replaced export is re-entered.

Frozen suite callsites this entrypoint serves
---------------------------------------------
``tests/test_quantized_lstm.py`` (accuracy phase) calls the public ABI with nine
positional arguments::

    flag_gems.quantized_lstm(inp, [h0, c0], [cell_params],
                             has_biases, num_layers, dropout, train,
                             bidirectional, batch_first)

``benchmark/test_quantized_lstm.py`` (core benchmark phase) keeps the
reference-only dequantized weight list in the measured input tuple
``(value, hx, [params], deq, has_biases, ...)``; its ``_candidate_call`` wrapper
already drops ``deq`` before invoking the injected callable, and the legacy
``base.Benchmark`` path (``gems_op`` lambda) drops it inside the lambda.  A
leading list/tuple payload is therefore also accepted and discarded here, so
both callsites reach the same public ``aten::quantized_lstm.input`` ABI.  ``deq``
belongs only to the native floating-point baseline and is never a candidate
input.

Semantics preserved from the operator contract
----------------------------------------------
* Gate layout ``i, f, g, o`` (four ``hidden_size`` blocks of the stacked
  weights), ``c' = sigmoid(f) * c + sigmoid(i) * tanh(g)``,
  ``h' = sigmoid(o) * tanh(c')``.
* ``batch_first`` transposes input/output around the recurrent core.
* ``bidirectional`` runs a second reversed direction; each direction's output
  stays aligned to its own timestep and the two directions are concatenated on
  the last dim.
* ``num_layers`` stacks layers, taking each layer's own cell params; dropout is
  applied between layers only, and only when ``train`` and ``dropout > 0``.
* Dequantized weights are recovered from the packed ``CellParamsBase`` handles
  through ``quantized.linear_unpack`` + ``dequantize`` and rounded to the input
  dtype exactly like the operator does, so the int8 quantization error of the
  prepacked weights stays in the result.
* Gate accumulation happens in float32 (the operator's accumulation type);
  ``output``, ``hy`` and ``cy`` are returned in the input dtype, on the input
  device, and no input tensor is mutated or aliased.
"""

import torch

__all__ = ["run"]

# Accumulation type of the operator's gate math, per input dtype.
_WORK_DTYPE = {torch.float16: torch.float32, torch.bfloat16: torch.float32}


def _unpack_cell_params(param):
    """Recover ``(w_ih, w_hh, b_ih, b_hh)`` from one layer's cell params."""
    if isinstance(param, torch.ScriptObject):
        state = param.__getstate__()[0]
        biases, packed = state[1], state[4]
        w_ih = torch.ops.quantized.linear_unpack(packed[0])[0].dequantize()
        w_hh = torch.ops.quantized.linear_unpack(packed[1])[0].dequantize()
        b_ih = biases[0] if len(biases) > 0 else None
        b_hh = biases[1] if len(biases) > 1 else None
    else:
        # Deprecated flat [w_ih, w_hh, b_ih, b_hh] overload input.
        w_ih, w_hh = param[0], param[1]
        if w_ih.is_quantized:
            w_ih = w_ih.dequantize()
        if w_hh.is_quantized:
            w_hh = w_hh.dequantize()
        b_ih = param[2] if len(param) > 2 else None
        b_hh = param[3] if len(param) > 3 else None
    return w_ih, w_hh, b_ih, b_hh


def _prepare(tensor, device, out_dtype, work_dtype):
    """Round to the operator's stored dtype, then upcast for accumulation."""
    if tensor is None:
        return None
    return tensor.to(device=device, dtype=out_dtype).to(work_dtype)


def _run_direction(x, h, c, w_ih, w_hh, b_ih, b_hh, reverse, out_dtype):
    """Drive one direction over the whole sequence in the accumulation dtype."""
    seq_len = x.shape[0]
    outputs = [None] * seq_len
    steps = range(seq_len - 1, -1, -1) if reverse else range(seq_len)
    w_ih_t = w_ih.t()
    w_hh_t = w_hh.t()

    for t in steps:
        gates = x[t] @ w_ih_t + h @ w_hh_t
        if b_ih is not None:
            gates = gates + b_ih + b_hh
        g_i, g_f, g_g, g_o = gates.chunk(4, dim=-1)
        c = torch.sigmoid(g_f) * c + torch.sigmoid(g_i) * torch.tanh(g_g)
        h = torch.sigmoid(g_o) * torch.tanh(c)
        outputs[t] = h

    return (
        torch.stack(outputs).to(out_dtype),
        h.to(out_dtype),
        c.to(out_dtype),
    )


def run(input, hx, params, *args, dtype=None, use_dynamic=False):
    """Reference implementation of ``aten::quantized_lstm.input``."""
    del dtype, use_dynamic  # schema-compatibility arguments, unused by the op

    spec = list(args)
    if spec and isinstance(spec[0], (list, tuple)):
        # Reference-only dequantized weights of the benchmark input tuple.
        spec.pop(0)
    (
        has_biases,
        num_layers,
        dropout,
        train,
        bidirectional,
        batch_first,
    ) = spec[:6]

    device = input.device
    out_dtype = input.dtype
    work_dtype = _WORK_DTYPE.get(out_dtype, out_dtype)

    if batch_first:
        x = input.transpose(0, 1)
    else:
        x = input
    # Copies (never aliases the caller's input) and accumulates in work_dtype.
    layer_input = x.contiguous().to(work_dtype)

    h0, c0 = hx[0], hx[1]
    num_directions = 2 if bidirectional else 1
    params_per_layer = len(params) // num_layers

    h_final = []
    c_final = []

    for layer in range(num_layers):
        dir_outputs = []
        for direction in range(num_directions):
            idx = layer * num_directions + direction
            param = params[layer * params_per_layer + direction]
            w_ih, w_hh, b_ih, b_hh = _unpack_cell_params(param)
            w_ih = _prepare(w_ih, device, out_dtype, work_dtype)
            w_hh = _prepare(w_hh, device, out_dtype, work_dtype)
            if has_biases and b_ih is not None and b_hh is not None:
                b_ih = _prepare(b_ih, device, out_dtype, work_dtype)
                b_hh = _prepare(b_hh, device, out_dtype, work_dtype)
            else:
                # has_biases=False, or a params payload without both biases:
                # the operator adds no bias in either case.
                b_ih, b_hh = None, None

            h = h0[idx].to(device=device, dtype=work_dtype)
            c = c0[idx].to(device=device, dtype=work_dtype)

            out, hy, cy = _run_direction(
                layer_input, h, c, w_ih, w_hh, b_ih, b_hh, direction == 1, out_dtype
            )
            dir_outputs.append(out)
            h_final.append(hy)
            c_final.append(cy)

        layer_input = (
            dir_outputs[0] if num_directions == 1 else torch.cat(dir_outputs, dim=-1)
        )

        # Dropout applies between layers only, never after the last one.
        if train and dropout > 0.0 and layer < num_layers - 1:
            layer_input = torch.nn.functional.dropout(
                layer_input, p=dropout, training=True
            )
        if layer < num_layers - 1:
            layer_input = layer_input.to(work_dtype)

    output = layer_input
    if batch_first:
        output = output.transpose(0, 1)

    return output, torch.stack(h_final), torch.stack(c_final)
