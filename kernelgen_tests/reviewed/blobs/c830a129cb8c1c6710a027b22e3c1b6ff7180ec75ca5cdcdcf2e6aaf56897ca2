"""

import torch


def run(
    input,
    kernel_size,
    stride=None,
    padding=0,
    dilation=1,
    ceil_mode=False,
):
    """Return ``(values, indices)`` for 2D max pooling with the native oracle."""
    values, indices = torch.nn.functional.max_pool2d_with_indices(
        input,
        kernel_size=kernel_size,
        stride=stride,
        padding=padding,
        dilation=dilation,
        ceil_mode=ceil_mode,
    )
    return values, indices
