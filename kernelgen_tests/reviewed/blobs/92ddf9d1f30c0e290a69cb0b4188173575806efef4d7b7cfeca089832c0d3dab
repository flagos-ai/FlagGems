# Frozen master benchmark suite for ``special_round``, preserved unchanged.
# It only imports the shared framework modules that already exist in the
# frozen dev tree (``benchmark/base.py``, ``benchmark/consts.py``), so both
# master workloads are kept: the functional ``special_round`` case
# (``torch.special.round`` native baseline) and the ``special_round_out``
# case (``torch.ops.aten.special_round.out`` native baseline, out passed
# through kwargs by ``UnaryPointwiseOutBenchmark``).

import pytest
import torch

from . import base, consts


@pytest.mark.special_round
def test_special_round():
    bench = base.UnaryPointwiseBenchmark(
        op_name="special_round",
        torch_op=torch.special.round,
        dtypes=consts.FLOAT_DTYPES,
    )
    bench.run()


@pytest.mark.special_round_out
def test_special_round_out():
    # UnaryPointwiseOutBenchmark passes out= via kwargs internally
    bench = base.UnaryPointwiseOutBenchmark(
        op_name="special_round_out",
        torch_op=torch.ops.aten.special_round.out,
        dtypes=consts.FLOAT_DTYPES,
    )
    bench.run()
