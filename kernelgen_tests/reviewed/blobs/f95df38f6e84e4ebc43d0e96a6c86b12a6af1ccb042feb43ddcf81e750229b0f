"""Reference oracle for ``arange_start`` / ``arange_start_step`` (op 1174).

Reproduces the two frozen master call sites with upstream ATen ``torch.arange``:

* accuracy ``tests/test_arange_start.py::test_arange`` and the two inference
  tests call
  ``flag_gems.arange_start(start, end, step, dtype=..., device=..., pin_memory=...)``
  positionally for ``start``/``end``/``step`` and by keyword otherwise;
* benchmark ``benchmark/test_arange.py::test_arange_start_step`` builds inputs
  from ``{"start", "end", "step", "device", "dtype"}`` and passes them all as
  keyword arguments through ``GenericBenchmark``/``torch.arange``.

Only the device resolution documented by the frozen master accuracy test is
mirrored: ``device=None`` selects the FlagGems device instead of ATen's CPU
default, because that same test computes its expected value on
``device or flag_gems.device``. ``dtype`` and ``pin_memory`` are forwarded
unchanged (``bool? pin_memory`` and ``ScalarType? dtype`` both accept ``None``),
so no argument is added, dropped or reinterpreted.

This module does not import or call the candidate implementation under test: it
is the replaced ``flag_gems.arange_start`` symbol itself.
"""

import torch

import flag_gems


def run(start, end, step=1, *, dtype=None, device=None, pin_memory=False):
    """Return ``torch.arange`` with the FlagGems wrapper's device resolution."""
    target_device = flag_gems.device if device is None else device
    return torch.arange(
        start,
        end,
        step,
        dtype=dtype,
        device=target_device,
        pin_memory=pin_memory,
    )
