"""Reference solution for `_unsafe_masked_index_put_accumulate`.

Thin wrapper over the native ATen op that both frozen suites already use as
their oracle/baseline:

* `tests/test_unsafe_masked_index_put_accumulate.py` computes `ref_out` with
  `torch._unsafe_masked_index_put_accumulate(...)`;
* `benchmark/test_unsafe_masked_index_put_accumulate.py` passes
  `torch_op=torch._unsafe_masked_index_put_accumulate` as the native baseline.

The wrapper keeps the exact positional ABI of the candidate call
(`flag_gems._unsafe_masked_index_put_accumulate(inp, mask, indices, values)`),
including `indices` as a tuple of per-dimension index tensors, returns a new
tensor with `inp`'s dtype/device/layout and mutates no input
(`effects.mutates: []`). It deliberately does not import `flag_gems`, so it can
never re-enter the injected candidate as its own oracle.
"""

import torch


def run(inp, mask, indices, values):
    """Return `inp` with `values` accumulated at the mask-selected `indices`."""
    return torch._unsafe_masked_index_put_accumulate(inp, mask, indices, values)
