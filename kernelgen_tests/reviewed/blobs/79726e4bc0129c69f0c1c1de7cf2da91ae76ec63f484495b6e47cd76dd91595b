# MASTER-ALIGNED ROWS
# ===========================================================================
#
# Extracted ``trunc`` row of the master table.  The master table cannot be
# imported (``flag_gems.ops._foreach_unary`` is absent from kernelgen-dev), so
# the row is transcribed field by field; the citation next to each constant
# says where the value comes from.  ``out_dtype_fn`` is ``same_dtype``: the
# output dtype is the input dtype for every accepted dtype (no int->float
# promotion, unlike the transcendentals).

_TRUNC_NAME = "trunc"

# master src/flag_gems/ops/_foreach_unary.py:539-541
_FLOAT = (torch.float16, torch.bfloat16, torch.float32, torch.float64)
_INT = (torch.int8, torch.int16, torch.int32, torch.int64, torch.uint8)

# master :546 -- NO_BOOL_NO_COMPLEX, the ``allowed`` set of the trunc row.
_TRUNC_ALLOWED = frozenset(_FLOAT + _INT)

# master :707 -- UnaryOp("trunc", _scalar_fn(trunc_func), same_dtype,
# NO_BOOL_NO_COMPLEX): no complex kernel and no 16-bit fast variant.
_TRUNC_COMPLEX_FN = None
_TRUNC_OUT_DTYPE_POLICY = "same_dtype"

# master :51 -- INT_DTYPES; master :50 -- FLOAT_DTYPES.
_MASTER_FLOAT_DTYPES = [torch.float16, torch.float32, torch.bfloat16]
_MASTER_INT_DTYPES = [torch.int16, torch.int32, torch.int64]

# master :131 -- UNIT_DOMAIN; ``trunc`` is not in it, so integral samples use
# randint(1, 5).
_UNIT_DOMAIN = {"acos", "asin"}


def _trunc_supports(dtype):
    """master :118-125 ``_supports`` for ``trunc`` on a non-kunlunxin backend.

    ``allowed is None or dtype in allowed``; the kunlunxin-only branch of the
    master helper does not apply to this backend.
    """
    allowed = _TRUNC_ALLOWED
    return allowed is None or dtype in allowed


def _master_sample(shape, dtype, name=_TRUNC_NAME):
    """master :134-152 ``_sample`` reproduced for ``name="trunc"``.

    Floats: ``rand * 0.8 + 0.1`` (positive, sub-unit).  Integers:
    ``randint(1, 5)`` because ``trunc`` is outside ``UNIT_DOMAIN``.  Complex and
    bool branches are kept identical to the master helper even though this
    operator's ``allowed`` set rejects both.
    """
    if dtype.is_floating_point:
        return torch.rand(shape, dtype=dtype, device=flag_gems.device) * 0.8 + 0.1
    if dtype.is_complex:
        real = torch.rand(shape, dtype=torch.float32, device=flag_gems.device) * 0.8 + 0.1
        imag = torch.rand(shape, dtype=torch.float32, device=flag_gems.device) * 0.8 + 0.1
        return torch.complex(real, imag).to(dtype)
    if dtype is torch.bool:
        return torch.randint(0, 2, shape, device=flag_gems.device).to(torch.bool)
    high = 2 if name in _UNIT_DOMAIN else 5
    return torch.randint(
        0 if name in _UNIT_DOMAIN else 1,
        high,
        shape,
        dtype=dtype,
        device=flag_gems.device,
    )


def _assert_lists_close(res, ref, name=_TRUNC_NAME):
    """master :155-162 ``_assert_lists_close`` (dtype parity, then values)."""
    assert len(res) == len(ref)
    for got, want in zip(res, ref):
        assert got.dtype == want.dtype, f"{name}: {got.dtype} != {want.dtype}"
        if got.dtype.is_floating_point or got.dtype.is_complex:
            utils.gems_assert_close(got, want, got.dtype)
        else:
            utils.gems_assert_equal(got, want)


@pytest.mark.foreach_trunc
@pytest.mark.parametrize("dtype", _MASTER_FLOAT_DTYPES)
def test_accuracy_foreach_unary_float_trunc(dtype):
    """master ``test_accuracy_foreach_unary_float[name=trunc]`` (master :245-256).

    Three ``(16, 8)`` tensors per call, reference built with ``to_reference``
    without an upcast (master keeps the reference dtype), candidate called
    through ``flag_gems.foreach_trunc``.
    """
    if not _trunc_supports(dtype):
        return
    inp = [_master_sample((16, 8), dtype) for _ in range(3)]
    ref_inp = [utils.to_reference(t) for t in inp]

    ref_out = _ATEN_OP(ref_inp)
    res_out = _gems_op(inp)

    _assert_lists_close(res_out, ref_out)


@pytest.mark.foreach_trunc
@pytest.mark.parametrize("dtype", _MASTER_INT_DTYPES)
def test_accuracy_foreach_unary_int_trunc(dtype):
    """master ``test_accuracy_foreach_unary_int[name=trunc]`` (master :259-274).

    int16/int32/int64, three ``(32,)`` tensors, ``trunc`` keeps the input dtype
    (``same_dtype``) and the values are compared exactly.
    """
    if not _trunc_supports(dtype):
        return
    inp = [_master_sample((32,), dtype, _TRUNC_NAME) for _ in range(3)]
    ref_inp = [utils.to_reference(t) for t in inp]

    ref_out = _ATEN_OP(ref_inp)
    res_out = _gems_op(inp)

    _assert_lists_close(res_out, ref_out)


@pytest.mark.foreach_trunc
def test_accuracy_foreach_unary_rejects_unsupported_dtype_trunc():
    """master ``test_accuracy_foreach_unary_rejects_unsupported_dtype[name=trunc]``.

    Master :310-322 walks ``(torch.bool, torch.int32, torch.complex64)``,
    skips the dtypes the table allows and requires ``RuntimeError`` from the
    candidate for the rest.  For ``trunc`` (``allowed=NO_BOOL_NO_COMPLEX``)
    that is ``torch.bool`` and ``torch.complex64``; ``torch.int32`` is allowed,
    so it is skipped exactly as in master.  This is the master bool-refusal row
    that the frozen dev suite lacked.
    """
    allowed = _TRUNC_ALLOWED
    if allowed is None:
        return
    refused = []
    for dtype in (torch.bool, torch.int32, torch.complex64):
        if dtype in allowed:
            continue
        inp = [_master_sample((8,), dtype, _TRUNC_NAME)]
        with pytest.raises(RuntimeError):
            _gems_op(inp)
        refused.append(dtype)
    # Preparation-side guard only: master has no trailing assertion, but a
    # wrong transcription of ``allowed`` would turn this row into a vacuous
    # pass and silently drop the bool/complex refusal coverage.
    assert refused == [torch.bool, torch.complex64], refused
