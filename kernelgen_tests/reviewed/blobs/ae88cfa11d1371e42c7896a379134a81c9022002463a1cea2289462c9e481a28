"""Preparation-only reference solution for the frozen FlagGems conv_tbc suite.

This module is the injected stand-in loaded through the existing official
protocol (``--override conv_tbc:<this file>:run``), which replaces the public
export ``flag_gems.conv_tbc`` at runtime via
``flag_gems.dynamic_registry.DynamicOpOverride``. It is not an optimized
candidate.

It forwards to exactly the oracle the frozen master test declares for its
expected side:

    ref_out = torch.conv_tbc(utils.to_reference(inp, True), ...)

so the values, dtype, device, shape and single-tensor return structure of
``aten::conv_tbc(Tensor self, Tensor weight, Tensor bias, int pad=0) -> Tensor``
are produced by the native operator itself. No tolerance, no dtype cast, no
CPU round-trip, no re-implementation and no import of the FlagGems candidate
module are involved; the Definition (definitions/conv_tbc.json) declares a
single ``out`` output with ``mutates: []`` and ``returns_alias_of: {}``, which a
freshly allocated native result satisfies.

Argument names follow the call ABI used by the frozen suites: the accuracy test
calls positionally (``inp, weight, bias, pad``) and the frozen master benchmark
passes the same four names as keyword arguments after
``benchmark/base.py::unpack_to_args_kwargs`` turns its input dict into kwargs.
"""

import torch


def run(input, weight, bias, pad=0):
    """Time-batch-channel convolution forward (aten::conv_tbc)."""
    return torch.conv_tbc(input, weight, bias, pad)
