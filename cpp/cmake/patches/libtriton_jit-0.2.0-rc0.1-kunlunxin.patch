+  static void launch_xpu_kernel(CUstream stream,
+                                CUfunction kernel,
+                                unsigned int grid_x,
+                                unsigned int grid_y,
+                                unsigned int grid_z,
+                                void** args,
+                                const LaunchOptions& opts) {
+    using ConfigFn = int (*)(int, int, void*);
+    using ArgumentFn = int (*)(const void*, size_t, size_t);
+    using LaunchFn = int (*)(void*);
+    static const ConfigFn configure = load_xpu_symbol<ConfigFn>("xpu_launch_config");
+    static const ArgumentFn set_argument = load_xpu_symbol<ArgumentFn>("xpu_launch_argument_set");
+    static const LaunchFn launch = load_xpu_symbol<LaunchFn>("xpu_launch_async");
+
+    size_t offset = 0;
+    for (size_t i = 0; i < opts.argument_sizes.size(); ++i) {
+      const size_t size = opts.argument_sizes[i];
+      const size_t alignment = opts.xpu_arch == 3 && size == 8 ? 8 : 4;
+      offset = align_up(offset, alignment);
+      int result = set_argument(args[i], size, offset);
+      if (result != 0) {
+        throw std::runtime_error(fmt::format("xpu_launch_argument_set failed with error {}", result));
+      }
+      offset += align_up(size, alignment);
+    }
+
+    for (const unsigned int* dim : {&grid_x, &grid_y, &grid_z}) {
+      int result = set_argument(dim, sizeof(*dim), offset);
+      if (result != 0) {
+        throw std::runtime_error(fmt::format("xpu_launch_argument_set(grid) failed with error {}", result));
+      }
+      offset += sizeof(*dim);
+    }
+
+    const uint64_t grid_size = static_cast<uint64_t>(grid_x) * grid_y * grid_z;
+    const unsigned int available_clusters = opts.cluster_num == 0 ? 12 : opts.cluster_num;
+    const unsigned int cores = opts.core_num == 0 ? 64 : opts.core_num;
+    int result = configure(static_cast<int>(std::min<uint64_t>(grid_size, available_clusters)),
+                           static_cast<int>(cores),
+                           reinterpret_cast<void*>(stream));
+    if (result != 0) throw std::runtime_error(fmt::format("xpu_launch_config failed with error {}", result));
+    result = launch(reinterpret_cast<void*>(kernel));
+    if (result != 0) throw std::runtime_error(fmt::format("xpu_launch_async failed with error {}", result));
+  }
