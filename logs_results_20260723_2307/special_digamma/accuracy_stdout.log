        frac = torch.rand(shape, dtype=dtype, device=flag_gems.device) * 0.8 + 0.1
        inp = -(base + frac.float()).to(dtype)
        ref_inp = utils.to_reference(inp)
    
        ref_out = torch.special.digamma(ref_inp)
        with flag_gems.use_gems():
