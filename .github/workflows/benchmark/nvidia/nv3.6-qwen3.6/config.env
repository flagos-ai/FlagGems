# ==============================================================================
# 硬件配置 (Hardware Configuration)
# ==============================================================================
# 将 CPU 绑定到特定的 NUMA 节点，以最大化内存带宽
NUMA_CPUNODEBIND=1
# 将内存分配绑定到特定的 NUMA 节点
NUMA_MEMBIND=1
# 锁定 GPU 核心频率 (MHz)，以减少压测结果的波动
GPU_LOCK_CLOCK=1830
# 用于启动服务和压测的 GPU 列表 (如果未设置，默认使用 4 和 5 号卡)
CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}

# ==============================================================================
# 模型与连接信息 (Model & Connection Info)
# ==============================================================================
# 模型权重所在的本地路径 (必填项)
MODEL_PATH="/path/to//Qwen3.6-XXB" # require

# OpenAI API 接口对外暴露的模型名称
SERVED_MODEL_NAME="qwen36"

# vLLM 服务监听的端口 (如果未设置，默认 7000)
VLLM_QWEN3_PORT=${VLLM_QWEN3_PORT:-7000}

# 要加载的 vLLM 插件 (例如 "fl" 代表 FlagOS)
VLLM_PLUGINS="fl"

# ==============================================================================
# vLLM 服务端配置 (vLLM Serve Configuration)
# ==============================================================================
# 用于张量并行 (Tensor Parallelism) 的 GPU 数量
TENSOR_PARALLEL_SIZE=2
# 模型支持的最大上下文长度 (Context Length)
MAX_MODEL_LEN=65536
# 模型权重与 KV 缓存的数据类型 ("bfloat16", "float16", "auto")
DTYPE="bfloat16"
# 预分配给 vLLM 实例的显存比例 (0.0 - 1.0)
GPU_MEM_UTIL=0.8
# 设为 1 以启用 FlagGems 算子替换
USE_FLAGGEMS=1

# ==============================================================================
# 运行模式开关 (Run Mode Toggles)
# ==============================================================================
# 是否启用 PyTorch Profiler 抓取 Trace (true / false)
ENABLE_PROFILER="true"
# 是否强制使用 Eager 模式 (禁用 CUDA Graph，常用于排查精度或兼容性问题)
ENABLE_EAGER="false"

# ==============================================================================
# Profiler 配置 (Profiler Configuration)
# ==============================================================================
# 生成的 .pt.trace.json.gz 文件保存目录
PROFILER_DIR="/data/subingzhen/profiling"

# 预热丢弃的迭代次数。
# PROFILER_WARMUP_ITERS=4
# 正式采集的迭代次数。
# PROFILER_ACTIVE_ITERS=10

# 记录张量形状 (如果你要用脚本分析 Shape 耗时，强烈建议设为 true)
PROFILER_RECORD_SHAPES=true
# 记录 Python 调用栈 (会带来巨大的性能开销，通常不需要)
PROFILER_RECORD_STACK=false
# 记录内存分配事件
PROFILER_RECORD_MEMORY=false
# 估算算子的 FLOPs
PROFILER_RECORD_FLOPS=false
# 在 trace 汇总信息中导出 CUDA 总耗时
PROFILER_DUMP_CUDA_TIME_TOTAL=false
# 忽略 Python 前端事件以减小 trace 体积
IGNORE_FRONTEND=true

# ==============================================================================
# vLLM 压测配置 (vLLM Benchmark Configuration)
# ==============================================================================
# 客户端预热请求数
BENCH_WARMUPS=4
# 压测发送的总请求数 (不包含预热请求)
BENCH_NUM_PROMPTS=10
# 每个请求的随机输入 Token 长度
BENCH_INPUT_LEN=4096
# 每个请求的随机输出 Token 长度
BENCH_OUTPUT_LEN=1024
# 最大并发请求数
BENCH_CONCURRENCY=16
# Tokenizer 的路径 (通常与 MODEL_PATH 相同)
BENCH_TOKENIZER_PATH="/path/to//Qwen3.6-27B"
# 压测结果 .txt 文件的保存目录
BENCH_OUTPUT_DIR="./unit_test_output"

# ==============================================================================
# 日志与启动重试策略 (Logging & Start Retry Policy)
# ==============================================================================
# vLLM 服务端日志重定向的文件名
VLLM_LOG_FILE="vllm.log"
# 记录后台进程 PID 的文件名
PID_FILE="pid.txt"
# 健康检查的最大重试次数
MAX_RETRY=180
# 每次健康检查重试的间隔时间 (秒)
RETRY_INTERVAL_SEC=10