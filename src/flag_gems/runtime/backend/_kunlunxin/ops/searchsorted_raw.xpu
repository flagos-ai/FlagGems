// tle.raw payload for searchsorted (xpu3 cluster/SIMT path).
//
// Rationale: searchsorted's hot path is a data-dependent gather chain (binary
// lifting probes seq[idx+step-1] for step=2^b). Triton's XPU codegen only emits
// a hardware vgather for COMPILE-TIME linear-ramp offsets; a runtime index
// tensor falls back to a ~log2(n) serial scalar-load loop, which is what caps
// the shipped Triton kernel. This payload instead stages the (loop-invariant)
// sorted sequence into each core's OWN local memory once, then runs a 16-wide
// SIMD bitwalk using vgather_lm (runtime per-lane offset gather from LM). No
// cross-core synchronization: each core stages independently.
//
// Coverage: fp32 variants serve fp16/bf16/fp32/int16/int8/uint8 (all exactly
// representable & order-preserving in fp32, so the search result is identical).
// int32 variants are native (int32 values > 2^24 are not fp32-exact).
//
// vgather offset is in BYTES (elem*sizeof), so probe element index p -> p*4.
// searchsorted: left(right==0)=#{seq<v}; right(right==1)=#{seq<=v}.
#include "xpu/kernel/xtdk.h"
#include "xpu/kernel/xtdk_simd.h"

#define VLEN 16
#define SEQMAX 1024

// ---- fp32 bitwalk step -------------------------------------------------------
static __device__ inline int32x16_t _stepL_f32(int32x16_t idx, int step, int sl,
                                                int right, const float *lseq,
                                                float32x16_t v) {
  int32x16_t nxt = svadd_int32x16(step, idx);
  int32x16_t clamped = svmin_int32x16(sl, nxt);
  int32x16_t probe = svadd_int32x16(-1, clamped);
  int32x16_t boff = svmul_int32x16(4, probe);
  float32x16_t mv = vgather_lm_float32x16(lseq, boff);
  // Match Triton's NaN semantics exactly: advance = ~go_left, where
  //   go_left = (v <= mv) for left, (v < mv) for right.
  // NOTE the operands are (v, mv): negating this is NOT the same as the
  // operand-swapped (mv < v) when v is NaN -- both v<=mv and mv<v are false
  // for NaN, so a NaN value must still advance (walk to the end), which only
  // ~(v<=mv)==true gives.
  int golf = right ? vvlt_float32x16(v, mv) : vvle_float32x16(v, mv);
  int cmp = (~golf) & 0xFFFF;
  int inr = (~svlt_int32x16(sl, nxt)) & 0xFFFF;
  int adv = cmp & inr;
  // WORKAROUND xpu-clang codegen bug: a runtime int mask fed DIRECTLY from a
  // vv-compare into a masked SIMD builtin (_mz/_mh) mis-lowers (result register
  // aliases the compare's float operand -> float bits leak into the int lanes,
  // non-deterministic by scheduling). Round-tripping the mask through LM forces
  // it into a GPR and the masked builtin then lowers correctly.
  __local__ int _mslot[1];
  _mslot[0] = adv;
  mfence_lm();
  int adv2 = _mslot[0];
  return svadd_int32x16_mh(step, idx, idx, adv2);
}

// ---- int32 bitwalk step ------------------------------------------------------
static __device__ inline int32x16_t _stepL_i32(int32x16_t idx, int step, int sl,
                                                int right, const int *lseq,
                                                int32x16_t v) {
  int32x16_t nxt = svadd_int32x16(step, idx);
  int32x16_t clamped = svmin_int32x16(sl, nxt);
  int32x16_t probe = svadd_int32x16(-1, clamped);
  int32x16_t boff = svmul_int32x16(4, probe);
  int32x16_t mv = vgather_lm_int32x16(lseq, boff);
  // int has no NaN; keep the same (v,mv) predicate form as fp32 for symmetry.
  int golf = right ? vvlt_int32x16(v, mv) : vvle_int32x16(v, mv);
  int cmp = (~golf) & 0xFFFF;
  int inr = (~svlt_int32x16(sl, nxt)) & 0xFFFF;
  int adv = cmp & inr;
  __local__ int _mslot[1];
  _mslot[0] = adv;
  mfence_lm();
  int adv2 = _mslot[0];
  return svadd_int32x16_mh(step, idx, idx, adv2);
}

extern "C" __device__ void ss_1d_f32(_global_ptr_ const float *seq,
                                      _global_ptr_ const float *vals,
                                      _global_ptr_ int *out, int sl, int n,
                                      int right, int logn) {
  __local__ __simd__ float lseq[SEQMAX];
  GM2LM(seq, lseq, sl * sizeof(float));
  __local__ __simd__ float lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);

  int gc = cluster_id() * core_num() + core_id();
  int gcn = cluster_num() * core_num();
  for (int start = gc * VLEN; start < n; start += gcn * VLEN) {
    int len = n - start < VLEN ? n - start : VLEN;
    GM2LM(vals + start, lv, len * sizeof(float));
    float32x16_t v = vload_lm_float32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_f32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + start, len * sizeof(int));
  }
  mfence();
}

extern "C" __device__ void ss_2d_f32(_global_ptr_ const float *seq,
                                      _global_ptr_ const float *vals,
                                      _global_ptr_ int *out, int rows, int sl,
                                      int vpr, int right, int logn) {
  __local__ __simd__ float lseq[SEQMAX];
  __local__ __simd__ float lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);

  int gc = cluster_id() * core_num() + core_id();
  int gcn = cluster_num() * core_num();
  int tiles_per_row = (vpr + VLEN - 1) / VLEN;
  long total = (long)rows * tiles_per_row;
  int cur_row = -1;
  for (long t = gc; t < total; t += gcn) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq, sl * sizeof(float));
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv, len * sizeof(float));
    float32x16_t v = vload_lm_float32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_f32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}

extern "C" __device__ void ss_1d_i32(_global_ptr_ const int *seq,
                                      _global_ptr_ const int *vals,
                                      _global_ptr_ int *out, int sl, int n,
                                      int right, int logn) {
  __local__ __simd__ int lseq[SEQMAX];
  GM2LM(seq, lseq, sl * sizeof(int));
  __local__ __simd__ int lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);

  int gc = cluster_id() * core_num() + core_id();
  int gcn = cluster_num() * core_num();
  for (int start = gc * VLEN; start < n; start += gcn * VLEN) {
    int len = n - start < VLEN ? n - start : VLEN;
    GM2LM(vals + start, lv, len * sizeof(int));
    int32x16_t v = vload_lm_int32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_i32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + start, len * sizeof(int));
  }
  mfence();
}

extern "C" __device__ void ss_2d_i32(_global_ptr_ const int *seq,
                                      _global_ptr_ const int *vals,
                                      _global_ptr_ int *out, int rows, int sl,
                                      int vpr, int right, int logn) {
  __local__ __simd__ int lseq[SEQMAX];
  __local__ __simd__ int lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);

  int gc = cluster_id() * core_num() + core_id();
  int gcn = cluster_num() * core_num();
  int tiles_per_row = (vpr + VLEN - 1) / VLEN;
  long total = (long)rows * tiles_per_row;
  int cur_row = -1;
  for (long t = gc; t < total; t += gcn) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq, sl * sizeof(int));
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv, len * sizeof(int));
    int32x16_t v = vload_lm_int32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_i32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}

// ---- widen-in-LM variants for casted dtypes -------------------------------
// The 5 dtypes below are all fp32/int32-exact and order-preserving, but their
// buffers are narrower than the gather element size. Rather than pay the slow
// gems .to(fp32) Python cast (the _to_copy override runs at ~1GB/s, ~11x slower
// than native XPU cast, which would dominate and regress the kernel), each core
// stages the raw narrow buffer into LM and WIDENS in-place to fp32/int32 there,
// then reuses the proven 16-wide bitwalk. The seq row is widened ONCE per row
// (contiguous-chunk tile striping makes the cur_row cache effective), so the
// widen cost amortizes across the row's value tiles. _PROBE-verified correct
// (0 mismatches) and >= the shipped native path on the shape3 geometry.
#define WIDEN_STRIPE                                                           \
  int gc = cluster_id() * core_num() + core_id();                             \
  int gcn = cluster_num() * core_num();                                       \
  int tiles_per_row = (vpr + VLEN - 1) / VLEN;                                \
  long total = (long)rows * tiles_per_row;                                    \
  long chunk = (total + gcn - 1) / gcn;                                       \
  long tbeg = (long)gc * chunk;                                               \
  long tend = tbeg + chunk < total ? tbeg + chunk : total;                    \
  int cur_row = -1;

// fp16 seq/vals -> widen to fp32 in LM -> fp32 bitwalk -> int32 out
extern "C" __device__ void ss_2d_f16w(_global_ptr_ const _Float16 *seq,
                                       _global_ptr_ const _Float16 *vals,
                                       _global_ptr_ int *out, int rows, int sl,
                                       int vpr, int right, int logn) {
  __local__ _Float16 lseq_h[SEQMAX];
  __local__ __simd__ float lseq[SEQMAX];
  __local__ _Float16 lv_h[VLEN];
  __local__ __simd__ float lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);
  WIDEN_STRIPE
  for (long t = tbeg; t < tend; ++t) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq_h, sl * sizeof(_Float16));
      for (int i = 0; i < sl; ++i) lseq[i] = (float)lseq_h[i];
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv_h, len * sizeof(_Float16));
    for (int i = 0; i < VLEN; ++i) lv[i] = (float)lv_h[i];
    float32x16_t v = vload_lm_float32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_f32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}

// bf16 seq/vals -> widen to fp32 in LM (bit shift, exact) -> fp32 bitwalk
extern "C" __device__ void ss_2d_bf16w(_global_ptr_ const unsigned short *seq,
                                       _global_ptr_ const unsigned short *vals,
                                       _global_ptr_ int *out, int rows, int sl,
                                       int vpr, int right, int logn) {
  __local__ unsigned short lseq_u[SEQMAX];
  __local__ __simd__ float lseq[SEQMAX];
  __local__ unsigned short lv_u[VLEN];
  __local__ __simd__ float lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);
  WIDEN_STRIPE
  for (long t = tbeg; t < tend; ++t) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq_u, sl * sizeof(unsigned short));
      for (int i = 0; i < sl; ++i) {
        unsigned int bits = (unsigned int)lseq_u[i] << 16;
        lseq[i] = *(float *)&bits;
      }
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv_u, len * sizeof(unsigned short));
    for (int i = 0; i < VLEN; ++i) {
      unsigned int bits = (unsigned int)lv_u[i] << 16;
      lv[i] = *(float *)&bits;
    }
    float32x16_t v = vload_lm_float32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_f32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}

// int16 seq/vals -> widen to int32 (sign extend) -> int32 bitwalk
extern "C" __device__ void ss_2d_i16w(_global_ptr_ const short *seq,
                                      _global_ptr_ const short *vals,
                                      _global_ptr_ int *out, int rows, int sl,
                                      int vpr, int right, int logn) {
  __local__ short lseq_s[SEQMAX];
  __local__ __simd__ int lseq[SEQMAX];
  __local__ short lv_s[VLEN];
  __local__ __simd__ int lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);
  WIDEN_STRIPE
  for (long t = tbeg; t < tend; ++t) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq_s, sl * sizeof(short));
      for (int i = 0; i < sl; ++i) lseq[i] = (int)lseq_s[i];
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv_s, len * sizeof(short));
    for (int i = 0; i < VLEN; ++i) lv[i] = (int)lv_s[i];
    int32x16_t v = vload_lm_int32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_i32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}

// int8 seq/vals -> widen to int32 (sign extend) -> int32 bitwalk
extern "C" __device__ void ss_2d_i8w(_global_ptr_ const char *seq,
                                     _global_ptr_ const char *vals,
                                     _global_ptr_ int *out, int rows, int sl,
                                     int vpr, int right, int logn) {
  __local__ char lseq_b[SEQMAX];
  __local__ __simd__ int lseq[SEQMAX];
  __local__ char lv_b[VLEN];
  __local__ __simd__ int lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);
  WIDEN_STRIPE
  for (long t = tbeg; t < tend; ++t) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq_b, sl * sizeof(char));
      for (int i = 0; i < sl; ++i) lseq[i] = (int)lseq_b[i];
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv_b, len * sizeof(char));
    for (int i = 0; i < VLEN; ++i) lv[i] = (int)lv_b[i];
    int32x16_t v = vload_lm_int32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_i32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}

// uint8 seq/vals -> widen to int32 (zero extend) -> int32 bitwalk
extern "C" __device__ void ss_2d_u8w(_global_ptr_ const unsigned char *seq,
                                     _global_ptr_ const unsigned char *vals,
                                     _global_ptr_ int *out, int rows, int sl,
                                     int vpr, int right, int logn) {
  __local__ unsigned char lseq_b[SEQMAX];
  __local__ __simd__ int lseq[SEQMAX];
  __local__ unsigned char lv_b[VLEN];
  __local__ __simd__ int lv[VLEN];
  __local__ __simd__ int lo[VLEN];
  __local__ __simd__ int lz[VLEN];
  for (int i = 0; i < VLEN; ++i) lz[i] = 0;
  int32x16_t zero = vload_lm_int32x16(lz);
  WIDEN_STRIPE
  for (long t = tbeg; t < tend; ++t) {
    int r = (int)(t / tiles_per_row);
    int start = (int)(t % tiles_per_row) * VLEN;
    if (r != cur_row) {
      GM2LM(seq + (long)r * sl, lseq_b, sl * sizeof(unsigned char));
      for (int i = 0; i < sl; ++i) lseq[i] = (int)lseq_b[i];
      cur_row = r;
    }
    int len = vpr - start < VLEN ? vpr - start : VLEN;
    GM2LM(vals + (long)r * vpr + start, lv_b, len * sizeof(unsigned char));
    for (int i = 0; i < VLEN; ++i) lv[i] = (int)lv_b[i];
    int32x16_t v = vload_lm_int32x16(lv);
    int32x16_t idx = zero;
    for (int b = logn; b >= 0; --b)
      idx = _stepL_i32(idx, 1 << b, sl, right, lseq, v);
    vstore_lm_int32x16(lo, idx);
    LM2GM(lo, out + (long)r * vpr + start, len * sizeof(int));
  }
  mfence();
}
