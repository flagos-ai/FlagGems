#include <acl/acl_rt.h>
#include <c_api/asc_simd.h>
#include <kernel_operator.h>
#include <cstdint>
using bf = bfloat16_t;
using vf = vector_f32;
using pred = vector_bool;
__simd_callee__ inline vf bfload(__ubuf__ bf* p) {
  vector_bf16 b;
  asc_loadalign_unpack(b, p);
  vf f;
  ::vcvt(f, b, asc_create_mask_b8(PAT_ALL), PART_EVEN, MODE_ZEROING);
  return f;
}
__simd_callee__ inline void bfstore(__ubuf__ bf* p, vf v) {
  vector_bf16 b;
  ::vcvt(b, v, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_EVEN, MODE_ZEROING);
  asc_storealign_pack((__ubuf__ uint32_t*)p, (vector_u32&)b, asc_create_mask_b32(PAT_ALL));
}
__simd_callee__ inline vf zero() {
  vf a;
  asc_duplicate_scalar(a, 0.f, asc_create_mask_b32(PAT_ALL));
  return a;
}
template <class A, class B>
__aicore__ inline void load(__ubuf__ A* dst, __gm__ B* src, int bytes) {
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)dst,
                       (__gm__ uint8_t*)src,
                       1,
                       bytes,
                       0,
                       0,
                       0,
                       (asc_load_l2_cache_mode)0,
                       bytes,
                       bytes);
}
template <class A, class B>
__aicore__ inline void store(__gm__ A* dst, __ubuf__ B* src, int bytes) {
  asc_copy_ub2gm_align((__gm__ uint8_t*)dst,
                       (__ubuf__ uint8_t*)src,
                       1,
                       bytes,
                       (asc_store_l2_cache_mode)4,
                       bytes,
                       bytes);
}
__simd_callee__ inline vf one() {
  vf v;
  asc_duplicate_scalar(v, 1.f, asc_create_mask_b32(PAT_ALL));
  return v;
}
__simd_callee__ inline vf fp8_read(__ubuf__ uint8_t* p) {
  vector_u8 bits;
  ::vlds(bits, p, 0, UNPK4_B8);
  vf v;
  ::vcvt(v, (vector_f8e4m3&)bits, asc_create_mask_b8(PAT_ALL), PART_P0, MODE_ZEROING);
  return v;
}
__simd_callee__ inline vf scales(__ubuf__ float* p, pred lo) {
  vf a, b;
  asc_loadalign_brc_elem(a, p, 0);
  asc_loadalign_brc_elem(b, p + 1, 0);
  return asc_select(a, b, lo);
}
__simd_callee__ inline vf sigmoid(vf x, pred m) {
  vf denom = asc_add(one(), asc_exp_sub(zero(), x, m), m);
  vf q = asc_div(one(), denom, m), err = one(), neg = asc_neg(denom, m);
  ::vmula(err, q, neg, m, MODE_ZEROING);
  // With a faithfully rounded quotient only one adjacent float can be closer.
  vector_s32 plus, minus;
  asc_add_scalar(plus, (vector_s32&)q, 1, m);
  asc_add_scalar(minus, (vector_s32&)q, -1, m);
  pred below = asc_lt(err, zero(), m);
  vf adj = asc_select((vf&)minus, (vf&)plus, below);
  vf e2 = one();
  ::vmula(e2, adj, neg, m, MODE_ZEROING);
  auto better = asc_lt(asc_abs(e2, m), asc_abs(err, m), m);
  return asc_select(adj, q, better);
}
__simd_callee__ inline void write_quant(
    vf v, __ubuf__ bf* grad, __ubuf__ uint8_t* q, __ubuf__ uint16_t* sf, pred lo, pred hi) {
  auto m = asc_create_mask_b32(PAT_ALL);
  bfstore(grad, v);
  vf mag = asc_abs(v, m);
  vf a = asc_reduce_max(mag, lo), b = asc_reduce_max(mag, hi);
  vector_u32 e0, e1, zidx;
  asc_duplicate_scalar(zidx, uint32_t(0), m);
  a = asc_max_scalar(a, .0001f, m);
  b = asc_max_scalar(b, .0001f, m);
  asc_add_scalar(e0, (vector_u32&)a, uint32_t(0x1fffff), m);
  asc_add_scalar(e1, (vector_u32&)b, uint32_t(0x1fffff), m);
  asc_shiftright_scalar(e0, e0, uint32_t(23), m);
  asc_shiftright_scalar(e1, e1, uint32_t(23), m);
  asc_add_scalar(e0, e0, uint32_t(-8), m);
  asc_add_scalar(e1, e1, uint32_t(-8), m);
  vector_u32 pair, shift;
  asc_shiftleft_scalar(shift, e1, uint32_t(8), m);
  asc_or(pair, e0, shift, m);
  asc_storealign_1st(sf, (vector_u16&)pair, 0);
  vector_u32 all0, all1, inv;
  asc_gather(all0, e0, zidx);
  asc_gather(all1, e1, zidx);
  asc_select(inv, all0, all1, lo);
  vector_u32 bias;
  asc_duplicate_scalar(bias, uint32_t(254), m);
  asc_sub(inv, bias, inv, m);
  asc_shiftleft_scalar(inv, inv, uint32_t(23), m);
  vf scaled = asc_mul(v, (vf&)inv, m);
  vector_f8e4m3 packed;
  ::vcvt(packed, scaled, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_P0, MODE_ZEROING);
  asc_storealign_pack_quarter((__ubuf__ uint32_t*)q, (vector_u32&)packed, 0, m);
}
// Compute both derivatives and their per-group scales before the BF16 rounding.
__simd_vf__ inline void swiglu(__ubuf__ uint8_t* x,
                               __ubuf__ float* sf,
                               __ubuf__ bf* g,
                               __ubuf__ bf* dx,
                               __ubuf__ uint8_t* q,
                               __ubuf__ uint16_t* out_sf,
                               int w) {
  const auto m = asc_create_mask_b32(PAT_ALL), lo = asc_create_mask_b32(PAT_VL32);
  vector_s32 lane;
  asc_arange(lane, 0);
  vector_s32 mid;
  asc_duplicate_scalar(mid, 32, m);
  auto hi = asc_ge(lane, mid, m);
  for (uint16_t r = 0; r < 8; r++) {
    for (uint16_t k = 0; k < w / 64; k++) {
      int off = r * w + 64 * k;
      vf a = asc_mul(fp8_read(x + off), scales(sf + r * w / 32 + 2 * k, lo), m);
      vf b = asc_mul(fp8_read(x + 8 * w + off), scales(sf + 8 * w / 32 + r * w / 32 + 2 * k, lo), m);
      vf s = sigmoid(a, m), gs = asc_mul(bfload(g + off), s, m);
      vf inside = asc_add(one(), asc_mul(a, asc_sub(one(), s, m), m), m);
      vf da = asc_mul(asc_mul(gs, b, m), inside, m), db = asc_mul(gs, a, m);
      write_quant(da, dx + off, q + off, out_sf + k * 16 + r, lo, hi);
      write_quant(db, dx + 8 * w + off, q + 8 * w + off, out_sf + (w / 64 + k) * 16 + r, lo, hi);
    }
  }
}
extern "C" __global__ __vector__ void swiglu_grad_a5(__gm__ uint8_t* x,
                                                     __gm__ float* sf,
                                                     __gm__ bf* g,
                                                     __gm__ bf* dx,
                                                     __gm__ uint8_t* q,
                                                     __gm__ uint16_t* os,
                                                     int n,
                                                     int h,
                                                     int w) {
  asc_init();
  int tasks = (n / 8) * (h / w);
  __ubuf__ uint8_t* a = (__ubuf__ uint8_t*)0;
  __ubuf__ float* scale = (__ubuf__ float*)(a + 16 * w);
  __ubuf__ bf* grad = (__ubuf__ bf*)(scale + 16 * w / 32);
  __ubuf__ bf* y = grad + 8 * w;
  __ubuf__ uint8_t* out = (__ubuf__ uint8_t*)(y + 16 * w);
  __ubuf__ uint16_t* sout = (__ubuf__ uint16_t*)(out + 16 * w);
  for (int t = block_idx; t < tasks; t += block_num) {
    int r = t % (n / 8) * 8, col = t / (n / 8) * w;
    long pos = (long)r * 2 * h + col;
    for (int s = 0; s < 2; s++) {
      asc_copy_gm2ub_align(a + s * 8 * w,
                           x + pos + s * h,
                           8,
                           w,
                           0,
                           0,
                           0,
                           (asc_load_l2_cache_mode)0,
                           2 * h,
                           w);
      asc_copy_gm2ub_align((__ubuf__ uint8_t*)(scale + s * 8 * w / 32),
                           (__gm__ uint8_t*)(sf + (pos + s * h) / 32),
                           8,
                           w / 8,
                           0,
                           0,
                           0,
                           (asc_load_l2_cache_mode)0,
                           h / 4,
                           w / 8);
    }
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)grad,
                         (__gm__ uint8_t*)(g + (long)r * h + col),
                         8,
                         2 * w,
                         0,
                         0,
                         0,
                         (asc_load_l2_cache_mode)0,
                         2 * h,
                         2 * w);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    swiglu(a, scale, grad, y, out, sout, w);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    for (int s = 0; s < 2; s++) {
      asc_copy_ub2gm_align((__gm__ uint8_t*)(dx + pos + s * h),
                           (__ubuf__ uint8_t*)(y + s * 8 * w),
                           8,
                           2 * w,
                           (asc_store_l2_cache_mode)4,
                           4 * h,
                           2 * w);
      asc_copy_ub2gm_align(q + pos + s * h, out + s * 8 * w, 8, w, (asc_store_l2_cache_mode)4, 2 * h, w);
      asc_copy_ub2gm_align((__gm__ uint8_t*)(os + (long)((col + s * h) / 64) * n + r),
                           (__ubuf__ uint8_t*)(sout + s * w / 64 * 16),
                           w / 64,
                           16,
                           (asc_store_l2_cache_mode)4,
                           2 * n,
                           32);
    }
    asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  }
}
extern "C" int launch_fast(
    void* stream, void* x, void* sf, void* g, void* dx, void* q, void* out, int n, int h) {
  int w = h % 1024 == 0 ? 1024 : h % 512 == 0 ? 512 : 256;
  int cores = n / 8 * (h / w);
  if (cores > 64) cores = 64;
  // clang-format off
 swiglu_grad_a5<<<cores,nullptr,stream>>>((uint8_t*)x,(float*)sf,(bf*)g,(bf*)dx,(uint8_t*)q,(uint16_t*)out,n,h,w);
  // clang-format on
  return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
