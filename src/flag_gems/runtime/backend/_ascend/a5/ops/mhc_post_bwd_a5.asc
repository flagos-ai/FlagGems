#include <acl/acl_rt.h>
#include <c_api/asc_simd.h>
#include <kernel_operator.h>
#include <cstdint>
using bf = bfloat16_t;
using vf = vector_f32;
using pred = vector_bool;
__simd_callee__ inline vf bfload(__ubuf__ bf* p) {
  vector_bf16 b;
  asc_loadalign_unpack(b, p);
  vf f;
  ::vcvt(f, b, asc_create_mask_b8(PAT_ALL), PART_EVEN, MODE_ZEROING);
  return f;
}
__simd_callee__ inline void bfstore(__ubuf__ bf* p, vf v) {
  vector_bf16 b;
  ::vcvt(b, v, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_EVEN, MODE_ZEROING);
  asc_storealign_pack((__ubuf__ uint32_t*)p, (vector_u32&)b, asc_create_mask_b32(PAT_ALL));
}
__simd_callee__ inline vf zero() {
  vf a;
  asc_duplicate_scalar(a, 0.f, asc_create_mask_b32(PAT_ALL));
  return a;
}
template <class A, class B>
__aicore__ inline void load(__ubuf__ A* dst, __gm__ B* src, int bytes) {
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)dst,
                       (__gm__ uint8_t*)src,
                       1,
                       bytes,
                       0,
                       0,
                       0,
                       (asc_load_l2_cache_mode)0,
                       bytes,
                       bytes);
}
template <class A, class B>
__aicore__ inline void store(__gm__ A* dst, __ubuf__ B* src, int bytes) {
  asc_copy_ub2gm_align((__gm__ uint8_t*)dst,
                       (__ubuf__ uint8_t*)src,
                       1,
                       bytes,
                       (asc_store_l2_cache_mode)4,
                       bytes,
                       bytes);
}

template <int S>
__simd_vf__ inline void grad_rows(
    __ubuf__ bf* inp, __ubuf__ bf* go, __ubuf__ bf* out, __ubuf__ float* w, __ubuf__ float* dw, int h) {
  auto mask = asc_create_mask_b32(PAT_ALL);
  vf coeff[S][4], sums[S][4];
#pragma unroll
  for (int i = 0; i < S; i++) {
#pragma unroll
    for (int j = 0; j < 4; j++) {
      asc_loadalign_brc_elem(coeff[i][j], w + i * 4 + j, 0);
      sums[i][j] = zero();
    }
  }
  for (uint16_t c = 0; c < h / 64; c++) {
    vf gs[4];
#pragma unroll
    for (int j = 0; j < 4; j++) gs[j] = bfload(go + j * h + 64 * c);
#pragma unroll
    for (int i = 0; i < S; i++) {
      vf x = bfload(inp + i * h + 64 * c), y = zero();
#pragma unroll
      for (int j = 0; j < 4; j++) {
        ::vmula(y, gs[j], coeff[i][j], mask, MODE_ZEROING);
        ::vmula(sums[i][j], gs[j], x, mask, MODE_ZEROING);
      }
      bfstore(out + i * h + 64 * c, y);
    }
  }
#pragma unroll
  for (int i = 0; i < S; i++) {
#pragma unroll
    for (int j = 0; j < 4; j++) {
      vf sum;
      asc_reduce_sum(sum, sums[i][j], mask);
      asc_storealign_1st(dw + 4 * i + j, sum, 0);
    }
  }
}
extern "C" __global__ __vector__ void mhc_backward(__gm__ bf* x,
                                                   __gm__ bf* r,
                                                   __gm__ float* p,
                                                   __gm__ float* c,
                                                   __gm__ bf* g,
                                                   __gm__ bf* dx,
                                                   __gm__ bf* dr,
                                                   __gm__ float* dp,
                                                   __gm__ float* dc,
                                                   int n,
                                                   int h) {
  asc_init();
  // Each token has three independent tasks: the activation gradient and two
  // pairs of residual gradients, each with its own FP32 coefficient reductions.
  constexpr int P = 3;
  constexpr int slots = 2;
  const int total = n * P, first = block_idx, stride = block_num;
  const int count = (total - 1 - first) / stride + 1;
  const int slot_bytes = (6) * 2 * h + 192;
  for (int tick = 0; tick < count + 1; tick++) {
    if (tick < count) {
      const int task = first + tick * stride, row = task / P, k = task % P, slot = tick % slots;
      __ubuf__ bf* a = (__ubuf__ bf*)(uintptr_t(slot) * slot_bytes);
      __ubuf__ float* w = (__ubuf__ float*)(a + (6) * h);
      event_t ev = (event_t)slot;
      if (tick >= slots) {
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, ev);
      }
      long pos = (long)row * h;
      {
        int scalar = k == 0 ? 0 : (2 * (k - 1));
        int streams = (k == 0) ? 1 : 2;
        load(a, k == 0 ? x + pos : r + 4 * pos + scalar * h, 2 * streams * h);
        load(a + (2) * h, g + 4 * pos, 8 * h);
        load(w, k == 0 ? p + 4 * row : c + 16 * row + 4 * scalar, 16 * streams);
      }
      asc_sync_notify(PIPE_MTE2, PIPE_V, ev);
    }
    if (tick > 0) {
      const int t = tick - 1, task = first + t * stride, row = task / P, k = task % P, slot = t % slots;
      event_t ev = (event_t)slot;
      __ubuf__ bf* a = (__ubuf__ bf*)(uintptr_t(slot) * slot_bytes);
      __ubuf__ float* w = (__ubuf__ float*)(a + (6) * h);
      int i = k == 0 ? 0 : (2 * (k - 1)), streams = (k == 0) ? 1 : 2;
      asc_sync_wait(PIPE_MTE2, PIPE_V, ev);
      if (streams == 1)
        grad_rows<1>(a, a + (2) * h, a, w, w + 24, h);
      else
        grad_rows<2>(a, a + 2 * h, a, w, w + 24, h);
      asc_sync_notify(PIPE_V, PIPE_MTE3, ev);
      asc_sync_wait(PIPE_V, PIPE_MTE3, ev);
      long pos = (long)row * h;
      {
        store(k == 0 ? dx + pos : dr + 4 * pos + i * h, a, streams * 2 * h);
        store(k == 0 ? dp + 4 * row : dc + 16 * row + 4 * i, w + 24, 16 * streams);
      }
      if (t + slots < count) asc_sync_notify(PIPE_MTE3, PIPE_MTE2, ev);
    }
  }
}
extern "C" int launch_fast(void* stream,
                           void* x,
                           void* r,
                           void* p,
                           void* c,
                           void* g,
                           void* dx,
                           void* dr,
                           void* dp,
                           void* dc,
                           int n,
                           int h) {
  int cores = n < 64 ? n : 64;
  // clang-format off
 mhc_backward<<<cores,nullptr,stream>>>((bf*)x,(bf*)r,(float*)p,(float*)c,(bf*)g,(bf*)dx,(bf*)dr,(float*)dp,(float*)dc,n,h);
  // clang-format on
  return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
