// SPDX-License-Identifier: Apache-2.0
// MBK x BKN -> MBN. CANN Blaze supplies the block-level MX cube pipeline.
// This kernel owns tile assignment, storage strides and output placement.
#include <acl/acl_rt.h>
#include "kernel_operator.h"
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
#include "blaze/gemm/block/block_mmad_qbmm_mx.h"
namespace {
namespace te = asc::te;
using namespace AscendC;
using ND = te::nd_ext_layout_ptn;
using SA = te::scalea_nd_layout_ptn;
using SB = te::scaleb_nd_layout_ptn;
using Q = fp8_e4m3fn_t;
using S = fp8_e8m0_t;
using C = bfloat16_t;
using Policy = Blaze::Gemm::MatmulWithScaleMx<0, false, Blaze::Gemm::KernelMmadMultiBlockTQBMM>;
using MMA = Blaze::Gemm::Block::BlockMmad<Policy, Q, ND, Q, ND, C, ND, float, ND>;
template <class Layout, int Packing, class T>
__aicore__ inline auto matrix(__gm__ T* p, long rows, long cols) {
  using Form = te::frame_layout_format<Layout, Std::Int<Packing>>;
  return te::make_tensor(te::make_mem_ptr<te::location::gm>(p), Form {}(rows, cols));
}
template <class T>
__aicore__ inline auto window(const T& t, long rows, long cols) {
  return t.slice(te::make_coord(0L, 0L), te::make_shape(rows, cols));
}
__aicore__ inline void calculate(
    __gm__ Q* a, __gm__ Q* w, __gm__ S* sa, __gm__ S* sw, __gm__ C* y, long m, long batch, long k, long n) {
  const long bm = m == 1 ? 16 : 128;
  constexpr long bn = 256, bk = 128, kl1 = 512;
  using Shape = te::shape<long, long, long, long>;
  MMA mma;
  Shape problem {m, n, k, batch}, block {bm, bn, bk, 0L};
  mma.Init(problem, block, {(uint64_t)kl1, (uint64_t)kl1, 2}, false, false);
  long mt = (m + bm - 1) / bm, nt = n / bn;
  // The larger M path interleaves batches to give each core adjacent N tiles.
  for (long id = GetBlockIdx(); id < mt * nt * batch; id += GetBlockNum()) {
    long b, tm, tn;
    if (m == 1) {
      tn = id % nt;
      tm = (id / nt) % mt;
      b = id / (nt * mt);
    } else {
      b = id % batch;
      tn = id / batch % nt;
      tm = id / (batch * nt);
    }
    long row = tm * bm, col = tn * bn, actual = m - row < bm ? m - row : bm;
    // Physical row strides include batch for A, the activation scales and C.
    auto A = matrix<ND, 32>(a + (row * batch + b) * k, actual, batch * k);
    auto W = matrix<ND, 32>(w + b * k * n + col, k, n);
    auto AS = matrix<SA, 2>(sa + (row * batch + b) * (k / 32), actual, batch * k / 32);
    auto WS = matrix<SB, 2>(sw + b * (k / 32) * n + col * 2, k / 32, n);
    auto Cmat = matrix<ND, 16>(y + (row * batch + b) * n + col, actual, batch * n);
    auto bias = matrix<ND, 8>((__gm__ float*)y, 1L, bn);
    Shape valid {actual, bn, k, 0L};
    mma(window(A, actual, k),
        window(W, k, bn),
        window(AS, actual, k / 32),
        window(WS, k / 32, bn),
        bias,
        window(Cmat, actual, bn),
        valid);
  }
}
}  // namespace
#endif
extern "C" __global__ __cube__ void tq_mx_cube(__gm__ uint8_t* a,
                                               __gm__ uint8_t* w,
                                               __gm__ uint8_t* sa,
                                               __gm__ uint8_t* sw,
                                               __gm__ uint8_t* y,
                                               int m,
                                               int b,
                                               int k,
                                               int n) {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
  calculate((__gm__ Q*)a, (__gm__ Q*)w, (__gm__ S*)sa, (__gm__ S*)sw, (__gm__ C*)y, m, b, k, n);
#endif
}
extern "C" int tq_launch(
    void* stream, void* a, void* w, void* sa, void* sw, void* y, int m, int b, int k, int n) {
  long bm = m == 1 ? 16 : 128;
  long tiles = ((m + bm - 1) / bm) * (n / 256L) * b;
  int cores = tiles < 32 ? static_cast<int>(tiles) : 32;
  tq_mx_cube<<<cores, nullptr, stream>>>((uint8_t*)a, (uint8_t*)w, (uint8_t*)sa,
                                         (uint8_t*)sw, (uint8_t*)y, m, b, k, n);
  return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
