__simd_callee__ inline vf splat(float x) {
  vf v;
  asc_duplicate_scalar(v, x, asc_create_mask_b32(PAT_ALL));
  return v;
}
__simd_callee__ inline vf horner(vf p, vf t, float scalar, pred mask) {
  vf z = splat(scalar);
  ::vmula(z, p, t, mask, MODE_ZEROING);
  return z;
}
__simd_vf__ inline void score_rows(__ubuf__ float* data,
                                   __ubuf__ float* unbiased,
                                   __ubuf__ float* bias,
                                   int rows) {
  auto mask = asc_create_mask_b32(PAT_ALL);
  for (uint16_t j = 0; j < rows * 4; j++) {
    int r = j / 4, k = j % 4;
    vf bias_value;
    asc_loadalign(bias_value, bias + k * 64, 0);
    vf x, a, t, logpart, l, pos, root, recip, refined, resid;
    asc_loadalign(x, data + 256 * r + 64 * k, 0);
    asc_abs(a, x, mask);
    asc_mul_scalar(a, a, -.5f, mask);
    asc_exp(a, a, mask);
    asc_mul(t, a, a, mask);
    asc_sub(t, splat(1), t, mask);
    vf p = splat(.000471802573883906f);
    p = horner(p, t, -.0004226923920214176f, mask);
    p = horner(p, t, -.00008536428504157811f, mask);
    p = horner(p, t, .002192076062783599f, mask);
    p = horner(p, t, .000292900949716568f, mask);
    p = horner(p, t, .004986039828509092f, mask);
    p = horner(p, t, .011144610121846199f, mask);
    p = horner(p, t, .03287079185247421f, mask);
    p = horner(p, t, .11599518358707428f, mask);
    l = horner(p, t, .8325546383857727f, mask);
    asc_mul(l, a, l, mask);
    asc_max_scalar(pos, x, 0.f, mask);
    ::vmula(pos, l, l, mask, MODE_ZEROING);
    asc_sqrt(root, pos, mask);
    asc_div(recip, splat(1), root, mask);
    asc_mul(refined, pos, recip, mask);
    asc_add(refined, refined, root, mask);
    asc_mul_scalar(refined, refined, .5f, mask);
    asc_neg(resid, pos, mask);
    ::vmula(resid, refined, refined, mask, MODE_ZEROING);
    asc_mul_scalar(recip, recip, -.5f, mask);
    ::vmula(refined, resid, recip, mask, MODE_ZEROING);
    vf score = asc_select(refined, l, asc_gt(x, zero(), mask));
    asc_storealign(unbiased + r * 256 + k * 64, score, 0, mask);
    asc_add(score, score, bias_value, mask);
    asc_storealign(data + r * 256 + k * 64, score, 0, mask);
  }
}
__simt_vf__ __launch_bounds__(1024) inline void select_routes(__ubuf__ uint8_t* raw,
                                                              int rows,
                                                              float scale,
                                                              int batch) {
  __ubuf__ float* data = (__ubuf__ float*)raw;
  __ubuf__ float* src = data + batch * 256;
  __ubuf__ int32_t* idx = (__ubuf__ int32_t*)(src + batch * 256);
  __ubuf__ float* weights = (__ubuf__ float*)(idx + batch * 16);
  // One warp owns one token; ties go to the smallest expert ID.
  const int lane = threadIdx.x % 32, r = threadIdx.x / 32;
  if (r >= rows) return;
  float local[8];
#pragma unroll
  for (int i = 0; i < 8; i++) local[i] = data[r * 256 + i * 32 + lane];
  int selected = 0;
#pragma unroll
  for (int rank = 0; rank < 8; rank++) {
    int id = lane;
    float best = local[0];
#pragma unroll
    for (int i = 1; i < 8; i++) {
      if (local[i] > best) {
        best = local[i];
        id = i * 32 + lane;
      }
    }
    const float maxval = asc_reduce_max(best);
    const int winner = asc_reduce_min(best == maxval ? id : 256);
    if (lane == rank) selected = winner;
#pragma unroll
    for (int i = 0; i < 8; i++)
      if (i * 32 + lane == winner) local[i] = -__builtin_inff();
  }
  const float v = lane < 8 ? src[r * 256 + selected] : 0.f;
  const float sum = asc_reduce_add(v);
  if (lane < 8) {
    idx[r * 16 + lane * 2] = selected;
    idx[r * 16 + lane * 2 + 1] = 0;
    weights[r * 8 + lane] = v / (sum + 1.e-20f) * scale;
  }
}
extern "C" __global__ __vector__ void moe_score_route(
    __gm__ float* logits, __gm__ float* bias, __gm__ int64_t* idx, __gm__ float* wt, int n, float scale) {
  asc_init();
  const int batch = n <= 512 ? 8 : 32;
  const int count = (n + batch - 1) / batch;
  const int owned = (count - 1 - (int)block_idx) / (int)block_num + 1;
  if (block_idx >= count) return;
  const int span = batch * (256 + 256 + 16 + 8);
  __ubuf__ float* b = (__ubuf__ float*)(2 * span * 4);
  load(b, bias, 1024);
  for (int tick = 0; tick < owned + 1; tick++) {
    if (tick < owned) {
      int slot = tick % 2, row = (block_idx + tick * block_num) * batch,
          nr = n - row < batch ? n - row : batch;
      event_t ev = (event_t)slot;
      __ubuf__ float* data = (__ubuf__ float*)(uintptr_t(slot) * span * 4);
      if (tick >= 2) asc_sync_wait(PIPE_MTE3, PIPE_MTE2, ev);
      load(data, logits + (long)row * 256, nr * 1024);
      asc_sync_notify(PIPE_MTE2, PIPE_V, ev);
    }
    if (tick >= 1) {
      int t = tick - 1, slot = t % 2, row = (block_idx + t * block_num) * batch,
          nr = n - row < batch ? n - row : batch;
      event_t ev = (event_t)slot;
      __ubuf__ float* data = (__ubuf__ float*)(uintptr_t(slot) * span * 4);
      __ubuf__ float* src = data + batch * 256;
      __ubuf__ int32_t* out = (__ubuf__ int32_t*)(src + batch * 256);
      __ubuf__ float* weight = (__ubuf__ float*)(out + batch * 16);
      asc_sync_wait(PIPE_MTE2, PIPE_V, ev);
      score_rows(data, src, b, nr);
      asc_vf_call<select_routes>(cce::dim3(batch * 32), (__ubuf__ uint8_t*)data, nr, scale, batch);
      asc_sync_notify(PIPE_V, PIPE_MTE3, ev);
      asc_sync_wait(PIPE_V, PIPE_MTE3, ev);
      store(idx + (long)row * 8, out, nr * 64);
      store(wt + (long)row * 8, weight, nr * 32);
      if (t + 2 < owned) asc_sync_notify(PIPE_MTE3, PIPE_MTE2, ev);
    }
  }
}
