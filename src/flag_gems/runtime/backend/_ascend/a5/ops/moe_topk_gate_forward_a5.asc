#include <acl/acl_rt.h>
#include <c_api/asc_simd.h>
#include <kernel_operator.h>
#include <cstdint>
using vf = vector_f32;
using pred = vector_bool;
__simd_callee__ inline vf zero() {
  vf a;
  asc_duplicate_scalar(a, 0.f, asc_create_mask_b32(PAT_ALL));
  return a;
}
template <class A, class B>
__aicore__ inline void load(__ubuf__ A* dst, __gm__ B* src, int bytes) {
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)dst,
                       (__gm__ uint8_t*)src,
                       1,
                       bytes,
                       0,
                       0,
                       0,
                       (asc_load_l2_cache_mode)0,
                       bytes,
                       bytes);
}
template <class A, class B>
__aicore__ inline void store(__gm__ A* dst, __ubuf__ B* src, int bytes) {
  asc_copy_ub2gm_align((__gm__ uint8_t*)dst,
                       (__ubuf__ uint8_t*)src,
                       1,
                       bytes,
                       (asc_store_l2_cache_mode)4,
                       bytes,
                       bytes);
}
#include "simt_api/asc_simt.h"

// Match the official sqrt-softplus polynomial and its rounding before bias-based ranking.
/*
