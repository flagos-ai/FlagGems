#include <acl/acl_rt.h>
#include <c_api/asc_simd.h>
#include <kernel_operator.h>
using bf = bfloat16_t;
using vf = vector_f32;
using vb = vector_bf16;
using vu = vector_u16;
using pred = vector_bool;

__simd_callee__ inline vf vs(float x, pred m) {
  vf v;
  asc_duplicate_scalar(v, x, m);
  return v;
}
__simd_callee__ inline vu us(uint16_t x, pred m) {
  vu v;
  asc_duplicate_scalar(v, x, m);
  return v;
}
__simd_callee__ inline void unpack(vb a, vf& even, vf& odd) {
  ::vcvt(even, a, asc_create_mask_b8(PAT_ALL), PART_EVEN, MODE_ZEROING);
  ::vcvt(odd, a, asc_create_mask_b8(PAT_ALL), PART_ODD, MODE_ZEROING);
}
template <int B>
__simd_vf__ inline void quant_fp4(__ubuf__ bf* x, __ubuf__ uint8_t* y, __ubuf__ uint16_t* sf, int h) {
  pred m = asc_create_mask_b32(PAT_ALL), m16 = asc_create_mask_b16(PAT_ALL), m8 = asc_create_mask_b8(PAT_ALL);
  // 256 channels form eight scales. Pair even/odd channels before the
  // hardware block max and emit four packed scale words per tile.
  vu idx;
  asc_arange((vector_s16&)idx, 0);
  vu ix0, scatter;
  asc_shiftright_scalar(ix0, idx, uint16_t(4), m16);
  asc_shiftleft_scalar(scatter, idx, uint16_t(4), m16);
  for (uint16_t r = 0; r < B; ++r) {
    for (uint16_t tile = 0; tile < h / 256; ++tile) {
      const int base = tile * 256;
      vb y0, y1;
      asc_loadalign_deintlv(y0, y1, x + r * h + base);
      vu e = (vu&)y0, o = (vu&)y1;
      vu u, v, abs_mask = us(0x7fff, m16);
      asc_and(u, e, abs_mask, m16);
      asc_and(v, o, abs_mask, m16);
      asc_max(u, u, v, m16);
      vu mx;
      asc_reduce_max_datablock(mx, u, m16);
      // For BF16 magnitudes, ceil(log2(amax/448)) jumps after mantissa 96.
      vu exp;
      asc_add_scalar(exp, mx, uint16_t(63), m16);
      asc_shiftright_scalar(exp, exp, uint16_t(7), m16);
      asc_max_scalar(exp, exp, uint16_t(3), m16);
      asc_add_scalar(exp, exp, uint16_t(65534), m16);
      vu lo, hi;
      asc_deintlv(lo, hi, exp, exp);
      asc_shiftleft_scalar(hi, hi, uint16_t(8), m16);
      asc_or(lo, lo, hi, m16);
      asc_scatter(sf + tile * 4 * 16 + r, lo, scatter, asc_create_mask_b16(PAT_VL4));
      vu inv;
      asc_sub(inv, us(254, m16), exp, m16);
      asc_shiftleft_scalar(inv, inv, uint16_t(7), m16);
      vu v0;
      asc_gather(v0, inv, ix0);
      asc_mul(y0, y0, (vb&)v0, m16);
      asc_mul(y1, y1, (vb&)v0, m16);

      vb first, second;
      asc_intlv(first, second, y0, y1);
      vector_f4e2m1x2 low, high;
      ::vcvt(low, first, m8, ROUND_R, PART_P0, MODE_ZEROING);
      ::vcvt(high, second, m8, ROUND_R, PART_P0, MODE_ZEROING);
      asc_storealign_pack_quarter((__ubuf__ uint32_t*)(y + (r * h + base) / 2), (vector_u32&)low, 0, m8);
      asc_storealign_pack_quarter((__ubuf__ uint32_t*)(y + (r * h + base) / 2 + 64),
                                  (vector_u32&)high,
                                  0,
                                  m8);
    }
  }
}

template <int B>
__simd_vf__ inline void quant_fp8(__ubuf__ bf* x, __ubuf__ uint8_t* y, __ubuf__ uint16_t* sf, int h) {
  pred m = asc_create_mask_b32(PAT_ALL), m16 = asc_create_mask_b16(PAT_ALL), m8 = asc_create_mask_b8(PAT_ALL);
  // 256 channels form eight scales. Pair even/odd channels before the
  // hardware block max and emit four packed scale words per tile.

  // Accumulate the maxima from 256-channel stripes. Compute all scales for a row
  // together before broadcasting them back into sixteen-lane BF16 data blocks.
  __ubuf__ uint32_t* maxima = (__ubuf__ uint32_t*)(232 * 1024);
  __ubuf__ uint16_t* inverses = (__ubuf__ uint16_t*)(maxima + B * 64);
  vu idx, scatter;
  asc_arange((vector_s16&)idx, 0);
  asc_shiftleft_scalar(scatter, idx, uint16_t(4), m16);
  pred active;
  asc_lt(active, idx, us(h / 64, m16), m16);
  for (uint16_t r = 0; r < B; r++) {
    for (uint16_t tile = 0; tile < h / 256; tile++) {
      vb y0, y1;
      asc_loadalign_deintlv(y0, y1, x + r * h + tile * 256);
      vu a, b, mx, lo, hi;
      asc_and(a, (vu&)y0, us(0x7fff, m16), m16);
      asc_and(b, (vu&)y1, us(0x7fff, m16), m16);
      asc_max(a, a, b, m16);
      asc_reduce_max_datablock(mx, a, m16);
      asc_intlv(lo, hi, mx, us(0, m16));
      asc_storealign(maxima + r * 64 + tile * 8, (vector_u32&)lo, 0, asc_create_mask_b32(PAT_VL8));
    }
  }
  asc_mem_bar(VST_VLD);
  for (uint16_t r = 0; r < B; r++) {
    vector_u32 e, i, lo, hi, top;
    asc_loadalign(e, maxima + r * 64, 0);
    asc_add_scalar(e, e, uint32_t(31), m);
    asc_shiftright_scalar(e, e, uint32_t(7), m);
    asc_max_scalar(e, e, uint32_t(113), m);
    asc_add_scalar(e, e, uint32_t(-8), m);
    asc_duplicate_scalar(i, uint32_t(254), m);
    asc_sub(i, i, e, m);
    asc_shiftleft_scalar(i, i, uint32_t(7), m);
    asc_storealign_pack((__ubuf__ uint32_t*)(inverses + r * 64), i, m);
    asc_deintlv(lo, hi, e, e);
    asc_shiftleft_scalar(hi, hi, uint32_t(8), m);
    asc_or(lo, lo, hi, m);
    vu words, unused;
    asc_deintlv(words, unused, (vu&)lo, (vu&)lo);
    asc_scatter(sf + r, words, scatter, active);
  }
  asc_mem_bar(VST_VLD);
  for (uint16_t r = 0; r < B; r++) {
    for (uint16_t tile = 0; tile < h / 256; tile++) {
      const int base = tile * 256;
      vb y0, y1;
      asc_loadalign_deintlv(y0, y1, x + r * h + base);
      vb inv;
      asc_loadalign_brc_elem2datablock(inv, (__ubuf__ bf*)(inverses + r * 64 + 8 * tile));
      asc_mul(y0, y0, inv, m16);
      asc_mul(y1, y1, inv, m16);

      vb even_y = y0, odd_y = y1;
      vf a, b, c, d;
      unpack(even_y, a, b);
      unpack(odd_y, c, d);
      vector_f8e4m3 p0, p1, p2, p3;
      ::vcvt(p0, a, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_P0, MODE_ZEROING);
      ::vcvt(p2, b, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_P2, MODE_ZEROING);
      ::vcvt(p1, c, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_P1, MODE_ZEROING);
      ::vcvt(p3, d, asc_create_mask_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_P3, MODE_ZEROING);
      vector_u8 q;
      asc_or(q, (vector_u8&)p0, (vector_u8&)p2, m8);
      asc_or(q, q, (vector_u8&)p1, m8);
      asc_or(q, q, (vector_u8&)p3, m8);
      asc_storealign(y + r * h + base, q, 0, m8);
    }
  }
}

extern "C" __global__ __vector__ void cast_group32(
    __gm__ bf* x, __gm__ uint8_t* y, __gm__ uint16_t* sf, int rows, int h, int width, int fp4) {
  asc_init();
  const int tasks = (rows / 16) * (h / width), bytes = fp4 ? width / 2 : width;

  const int count = (tasks - 1 - block_idx) / block_num + 1;
  const int slot_bytes = 16 * width * 2 + 16 * bytes + width * 16 / 32;
  for (int t = 0; t < count + 2; t++) {
    if (t >= 2) {
      int tlocal = t - 2;
      int id = block_idx + tlocal * block_num;
      int row = id / (h / width) * 16, col = id % (h / width) * width;
      int slot = tlocal % 2;
      event_t ev = (event_t)slot;
      __ubuf__ bf* in = (__ubuf__ bf*)(uintptr_t(slot) * slot_bytes);
      __ubuf__ uint8_t* out = (__ubuf__ uint8_t*)(in + 16 * width);
      __ubuf__ uint16_t* scale = (__ubuf__ uint16_t*)(out + 16 * bytes);
      asc_sync_wait(PIPE_V, PIPE_MTE3, ev);
      asc_copy_ub2gm_align(y + ((long)row * h + col) / (fp4 ? 2 : 1),
                           out,
                           16,
                           bytes,
                           (asc_store_l2_cache_mode)4,
                           h / (fp4 ? 2 : 1),
                           bytes);
      asc_copy_ub2gm_align((__gm__ uint8_t*)(sf + (long)(col / 64) * rows + row),
                           (__ubuf__ uint8_t*)scale,
                           width / 64,
                           32,
                           (asc_store_l2_cache_mode)4,
                           2 * rows,
                           32);
      if (tlocal + 2 < count) asc_sync_notify(PIPE_MTE3, PIPE_MTE2, ev);
    }
    if (t < count) {
      int tlocal = t - 0;
      int id = block_idx + tlocal * block_num;
      int row = id / (h / width) * 16, col = id % (h / width) * width;
      int slot = tlocal % 2;
      event_t ev = (event_t)slot;
      __ubuf__ bf* in = (__ubuf__ bf*)(uintptr_t(slot) * slot_bytes);
      __ubuf__ uint8_t* out = (__ubuf__ uint8_t*)(in + 16 * width);
      __ubuf__ uint16_t* scale = (__ubuf__ uint16_t*)(out + 16 * bytes);
      if (tlocal >= 2) asc_sync_wait(PIPE_MTE3, PIPE_MTE2, ev);
      asc_copy_gm2ub_align((__ubuf__ uint8_t*)in,
                           (__gm__ uint8_t*)(x + (long)row * h + col),
                           16,
                           2 * width,
                           0,
                           0,
                           0,
                           (asc_load_l2_cache_mode)0,
                           2 * h,
                           2 * width);
      asc_sync_notify(PIPE_MTE2, PIPE_V, ev);
    }

    if (t >= 1 && t <= count) {
      int tlocal = t - 1;
      int id = block_idx + tlocal * block_num;
      int row = id / (h / width) * 16, col = id % (h / width) * width;
      int slot = tlocal % 2;
      event_t ev = (event_t)slot;
      __ubuf__ bf* in = (__ubuf__ bf*)(uintptr_t(slot) * slot_bytes);
      __ubuf__ uint8_t* out = (__ubuf__ uint8_t*)(in + 16 * width);
      __ubuf__ uint16_t* scale = (__ubuf__ uint16_t*)(out + 16 * bytes);
      asc_sync_wait(PIPE_MTE2, PIPE_V, ev);
      if (fp4) {
        if (width == 1024)
          quant_fp4<16>(in, out, scale, 1024);
        else if (width == 512)
          quant_fp4<16>(in, out, scale, 512);
        else
          quant_fp4<16>(in, out, scale, width);
      } else
        quant_fp8<16>(in, out, scale, width);
      asc_sync_notify(PIPE_V, PIPE_MTE3, ev);
    }
  }
}
extern "C" int launch_fast(void* stream, void* x, void* y, void* s, int n, int h, int fp4) {
  int width = h;
  while (width > 1024 && width % 512 == 0) width /= 2;
  if (width > 1024) width = 256;
  int cores = (n / 16) * (h / width);
  if (cores > 64) cores = 64;
  // clang-format off
 cast_group32<<<cores,nullptr,stream>>>((bf*)x,(uint8_t*)y,(uint16_t*)s,n,h,width,fp4);
  // clang-format on
  return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
